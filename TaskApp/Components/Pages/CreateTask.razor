@page "/createtask"
@page "/tasks/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using TaskApp.Data
@inject AppDbContext Db
@inject NavigationManager NavManager
@rendermode InteractiveServer

<!-- Dynamic Titles! -->
<PageTitle>@(Id == 0 ? "משימה חדשה" : "עריכת משימה")</PageTitle>

<h1>@(Id == 0 ? "משימה חדשה" : "עריכת משימה")</h1>

<div class="row mt-4">
    <div class="col-md-6">
        <!-- The EditForm now binds directly to currentTask -->
        <EditForm Model="currentTask" OnValidSubmit="SaveTask">
            
            <div class="mb-3">
                <label class="form-label">כותרת המשימה</label>
                <InputText @bind-Value="currentTask.Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">תיאור (אופציונלי)</label>
                <InputTextArea @bind-Value="currentTask.Description" class="form-control" rows="3" />
            </div>

            <div class="row mb-3">
                <div class="col">
                    <label class="form-label"> דחיפות (0-5) [נמוך חשוב יותר]</label>
                    <InputSelect @bind-Value="currentTask.Priority" class="form-select">
                        @for (int i = 0; i <= 5; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col">
                    <label class="form-label">מיקום</label>
                    <InputSelect @bind-Value="currentTask.Location" class="form-select">
                        @foreach (var loc in Enum.GetValues<Location>())
                        {
                            <option value="@loc">@loc</option>
                        }
                    </InputSelect>
                </div>
                <div class="col">
                    <label class="form-label">קטגוריה</label>
                    <InputSelect @bind-Value="currentTask.Category" class="form-select">
                        @foreach (var cat in Enum.GetValues<Category>())
                        {
                            <option value="@cat">@cat</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">שמירה</button>
            <a href="/" class="btn btn-outline-secondary ms-2">ביטול</a>
            
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    
    // We instantiate currentTask right away with your default values
    private TodoTask currentTask = new TodoTask 
    { 
        Priority = 0,
        Location = Location.כללי,
        Category = Category.כללי
    };

    protected override async Task OnInitializedAsync()
    {
        // If an ID was passed in the URL, overwrite the default task with the one from the database
        if (Id != 0)
        {
            var task = await Db.Tasks.FindAsync(Id);
            if (task != null)
            {
                currentTask = task;
            }
        }
    }

    private async Task SaveTask()
    {
        // The logic is now beautifully simple
        if (Id == 0)
        {
            Db.Tasks.Add(currentTask);
        }
        else
        {
            Db.Tasks.Update(currentTask);
        }
        
        // Save the changes to the SQLite file
        await Db.SaveChangesAsync();
        
        // Redirect the user back to the Home page
        NavManager.NavigateTo("/");
    }
}